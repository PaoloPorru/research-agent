# Password per entrare nell'app (scegline una lunga)
APP_PASSWORD=

# LLM gratuito: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxx
# Opzionale: modelli separati da virgola, provati in ordine (default openrouter/free)
OPENROUTER_MODELS=openrouter/free

# Memoria: Supabase -> Project Settings -> API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=

# Ricerca web (opzionale, 1000 ricerche/mese gratis): https://app.tavily.com
# Se manca si usa DuckDuckGo.
TAVILY_API_KEY=
